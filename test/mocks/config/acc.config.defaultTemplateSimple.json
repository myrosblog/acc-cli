{
  "schemas": [
    {
      "schemaId": "nms:localOrgUnit",
      "filename": "/Administration/Access Management/Organizational entities/{@name}.xml",
      "queryDef": {
        "where": { "condition": [{ "expr": "@name NOT LIKE 'xtk%'" }] }
      }
    },
    {
      "schemaId": "nms:deliveryMapping",
      "filename": "/Administration/Campaign Management/Target mappings/{@name}.xml",
      "queryDef": {
        "where": { "condition": [{ "expr": "@builtIn = false" }] }
      }
    },
    {
      "schemaId": "nms:typology",
      "filename": "/Administration/Campaign Management/Typology management/Typologies/{@name}.xml",
      "queryDef": {
        "where": { "condition": [{ "expr": "@name NOT LIKE 'xtk%'" }] }
      }
    },
    {
      "schemaId": "nms:typologyRule",
      "filename": "/Administration/Campaign Management/Typology management/Typology rules/{@name}.xml",
      "queryDef": {
        "where": { "condition": [{ "expr": "@name NOT LIKE 'xtk%'" }] }
      }
    },
    {
      "schemaId": "xtk:srcSchema",
      "filename": "/Administration/Configuration/Data schemas/{@namespace}/{@name}.xml",
      "queryDef": {
        "where": {
          "condition": [
            {
              "expr": "@namespace NOT IN ('xtk', 'nl', 'ncm','nms', 'sfdc', 'crm', 'acx', 'adb')"
            }
          ]
        }
      }
    },
    {
      "schemaId": "xtk:jssp",
      "filename": "/Administration/Configuration/Dynamic JavaScript pages/{@namespace}/{@name}.jsp",
      "queryDef": {
        "where": {
          "condition": [
            {
              "expr": "@namespace NOT IN ('xtk', 'nl', 'ncm','nms', 'sfdc', 'crm', 'acx', 'adb')"
            }
          ]
        }
      }
    },
    {
      "schemaId": "xtk:formRendering",
      "filename": "/Administration/Configuration/Form rendering/{@internalName}.css",
      "queryDef": {
        "where": {
          "condition": [
            {
              "expr": "@internalName NOT LIKE 'xtk%' AND @internalName NOT LIKE 'nl%' AND @internalName NOT LIKE 'ncm%' AND @internalName NOT LIKE 'nms%'"
            }
          ]
        }
      }
    },
    {
      "schemaId": "xtk:form",
      "filename": "/Administration/Configuration/Input forms/{@namespace}/{@name}.xml",
      "queryDef": {
        "where": {
          "condition": [
            {
              "expr": "@namespace NOT IN ('xtk', 'nl', 'ncm','nms', 'sfdc', 'crm', 'acx', 'adb')"
            }
          ]
        }
      }
    },
    {
      "schemaId": "xtk:javascript",
      "filename": "/Administration/Configuration/JavaScript codes/{@namespace}/{@name}.js",
      "queryDef": {
        "where": {
          "condition": [
            {
              "expr": "@namespace NOT IN ('xtk', 'nl', 'ncm','nms', 'sfdc', 'crm', 'acx', 'adb')"
            }
          ]
        }
      }
    },
    {
      "schemaId": "xtk:navtree",
      "filename": "/Administration/Configuration/Navigation hierarchies/{@namespace}/{@name}.xml",
      "queryDef": {
        "where": {
          "condition": [
            {
              "expr": "@namespace NOT IN ('xtk', 'nl', 'ncm','nms', 'sfdc', 'crm', 'acx', 'adb')"
            }
          ]
        }
      }
    },
    {
      "schemaId": "xtk:sql",
      "filename": "/Administration/Configuration/SQL scripts/{@namespace}/{@name}.sql",
      "queryDef": {
        "where": {
          "condition": [
            {
              "expr": "@namespace NOT IN ('xtk', 'nl', 'ncm','nms', 'sfdc', 'crm', 'acx', 'adb')"
            }
          ]
        }
      }
    },
    {
      "schemaId": "xtk:xslt",
      "filename": "/Administration/Configuration/XSL style sheets/{@namespace}/{@name}.xsl",
      "queryDef": {
        "where": {
          "condition": [
            {
              "expr": "@namespace NOT IN ('xtk', 'nl', 'ncm','nms', 'sfdc', 'crm', 'acx', 'adb')"
            }
          ]
        }
      }
    },
    {
      "schemaId": "xtk:workflow",
      "filename": "/Administration/Production/{@internalName}.xml",
      "queryDef": {
        "where": {
          "condition": [{ "expr": "@builtIn = false AND @isModel = true" }]
        }
      }
    },
    {
      "schemaId": "nms:operation",
      "filename": "/Campaign Management/Campaigns/{@internalName}.xml",
      "queryDef": {
        "where": {
          "condition": [{ "expr": "@builtIn = false AND @isModel = true" }]
        }
      }
    },
    {
      "schemaId": "nms:delivery",
      "filename": "/Campaign Management/Deliveries/{@internalName}.html",
      "queryDef": {
        "where": {
          "condition": [{ "expr": "@builtIn = false AND @isModel = true" }]
        }
      }
    },
    {
      "schemaId": "nms:includeView",
      "filename": "/Resources/Campaign Management/Personalization blocks/{@name}.xml",
      "queryDef": {
        "where": {
          "condition": [{ "expr": "@name NOT LIKE 'xtk%'" }]
        }
      }
    },
    {
      "schemaId": "nms:webApp",
      "filename": "/Resources/Online/Web applications/{@internalName}.xml",
      "queryDef": {
        "where": { "condition": [{ "expr": "@builtIn = false" }] }
      }
    },
    {
      "schemaId": "xtk:folder",
      "filename": "/Explorer/{@name}.meta.xml",
      "queryDef": {
        "lineCount": 100,
        "where": {
          "condition": [
            {
              "expr": "@builtIn = true"
            }
          ]
        }
      }
    }
  ]
}
