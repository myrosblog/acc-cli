{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemas"],
  "properties": {
    "alias": {
      "type": "string",
      "minLength": 1,
      "description": "Default instance alias for this project. Overridden by --alias."
    },
    "acc-js-sdk": {
      "type": "object",
      "not": {
        "anyOf": [{ "required": ["storage"] }, { "required": ["transport"] }]
      },
      "properties": {
        "traceAPICalls": { "type": "boolean" },
        "noStorage": { "type": "boolean" },
        "timeout": { "type": "number" },
        "instanceKey": { "type": "string" },
        "extraHttpHeaders": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schemaId", "filename"],
        "properties": {
          "schemaId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9]+:[a-zA-Z0-9]+$"
          },
          "filename": { "type": "string", "minLength": 1 },
          "excludeXPaths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "decompose": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "queryDef": {
            "type": "object",
            "properties": {
              "where": {
                "type": "object",
                "properties": {
                  "condition": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "expr": { "type": "string" }
                      },
                      "required": ["expr"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
