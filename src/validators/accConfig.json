{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaId": { "type": "string" },
          "filename": { "type": "string" },
          "queryDef": {
            "type": "object",
            "properties": {
              "where": {
                "type": "object",
                "properties": {
                  "condition": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "expr": { "type": "string" }
                      },
                      "required": ["expr"]
                    }
                  }
                },
                "required": ["condition"]
              }
            },
            "required": ["where"]
          }
        },
        "required": ["schemaId", "filename"]
      }
    }
  },
  "required": ["schemas"]
}